# Allowlist: the build context holds only what the Dockerfile needs.
# New files stay out of the image build unless they are admitted here.
*
!go.mod
!go.sum
!cmd
!internal
!frontend

# Inside what is admitted: not source.
frontend/node_modules
frontend/dist
frontend/tests
**/*.db
**/*.db-*
**/*.log
**/.jwt_secret
**/.env*
**/*.pem
**/*.key
